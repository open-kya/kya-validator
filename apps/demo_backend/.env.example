# KYA Validator Demo Backend Configuration

# Server Settings
HOST=0.0.0.0
PORT=8003
RELOAD=True

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# LLM Provider Settings
# Choose your preferred LLM provider: openai, google, huggingface, or glm
DEFAULT_LLM_PROVIDER=glm
DEFAULT_MODEL=glm-5

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Configuration
GOOGLE_API_KEY=your_google_api_key_here

# HuggingFace Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# GLM/Z.ai Configuration
GLM_API_KEY=
GLM_API_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5

# MCP (Model Context Protocol) Settings
MCP_ENABLED=true
MCP_SERVER_URL=
MCP_TIMEOUT=30
MCP_FALLBACK_TO_DIRECT=true

# Agent Settings
DEFAULT_AGENT_MODE=llm  # "llm" or "simulated"
AGENT_TIMEOUT=30
MAX_CONVERSATION_TURNS=20

# Validation Settings
VALIDATION_TIMEOUT=10
MAX_VALIDATION_RETRIES=3

# Storage Settings
TRANSCRIPT_STORAGE_PATH=./transcripts
ENABLE_TRANSCRIPT_PERSISTENCE=True

# Demo Settings
DEMO_SCENARIO_ID=default
DEMO_SECTOR=cloud_infrastructure  # cloud_infrastructure, ai_services, data_pipelines
